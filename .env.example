# ==== OAuth (Google) ====
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
OAUTH_REDIRECT_URI=https://example.com/rest/oauth2-credential/callback
GMAIL_SCOPES=openid email profile https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.send https://www.googleapis.com/auth/gmail.labels https://www.googleapis.com/auth/gmail.modify

# ==== OpenAI (classification) ====
OPENAI_API_KEY=
OPENAI_ASSISTANT_ID=

# ==== URLs ====
GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_USERINFO_URL=https://www.googleapis.com/oauth2/v1/userinfo
GMAIL_API_BASE_URL=https://gmail.googleapis.com/gmail/v1/users/me

# ==== Server ====
PORT=8082
